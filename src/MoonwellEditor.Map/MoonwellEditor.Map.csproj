<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The tests read a corner's whole variation byte (Cliffs.Raw). -->
  <ItemGroup>
    <InternalsVisibleTo Include="MoonwellEditor.Map.Tests" />
  </ItemGroup>

  <!-- The map-file types come from Moonwell.MapFiles; ObjectKind is Moonwell's Kind under the name the editor's code uses. -->
  <ItemGroup>
    <Using Include="Moonwell.MapFiles" />
    <Using Alias="ObjectKind" Include="Moonwell.GameData.Kind" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoonwellEditor.Files\MoonwellEditor.Files.csproj" />
    <ProjectReference Include="..\MoonwellEditor.GameData\MoonwellEditor.GameData.csproj" />
    <ProjectReference Include="..\MoonwellEditor.Model\MoonwellEditor.Model.csproj" />
  </ItemGroup>

</Project>
