<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The tests reach into MapArchive (its names, its file replace and the hooks that stand in for failures). -->
  <ItemGroup>
    <InternalsVisibleTo Include="MoonwellEditor.Files.Tests" />
    <InternalsVisibleTo Include="MoonwellEditor.Model.Tests" />
  </ItemGroup>

  <!-- The page's strings file, which holds the app's own text too (Texts). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\web\src\text\strings.json" LogicalName="strings.json" Link="strings.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sven's War3Net fork; 6.1.2-moonwell.4 writes object files back byte for byte. -->
    <PackageReference Include="Moonwell.War3Net.Build.Core" Version="6.1.2-moonwell.4" />
    <!-- Moonwell's game-data reader, for the tables the game reads under a map's data option (DataOptions). -->
    <PackageReference Include="Moonwell.GameData" Version="$(MoonwellVersion)" />
    <!-- A map's object files, the seven kinds and the id rules, shared with Moonwell's build. -->
    <PackageReference Include="Moonwell.MapFiles" Version="$(MoonwellVersion)" />
  </ItemGroup>

  <!-- The map-file types come from Moonwell.MapFiles; ObjectKind is Moonwell's Kind under the name the editor's code uses. -->
  <ItemGroup>
    <Using Include="Moonwell.MapFiles" />
    <Using Alias="ObjectKind" Include="Moonwell.GameData.Kind" />
  </ItemGroup>

</Project>
