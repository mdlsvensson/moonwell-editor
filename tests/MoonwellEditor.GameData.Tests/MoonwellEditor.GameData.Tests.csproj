<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The map-file types come from Moonwell.MapFiles; ObjectKind is Moonwell's Kind under the name the editor's code uses. -->
  <ItemGroup>
    <Using Include="Moonwell.MapFiles" />
    <Using Alias="ObjectKind" Include="Moonwell.GameData.Kind" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MoonwellEditor.GameData\MoonwellEditor.GameData.csproj" />
  </ItemGroup>

</Project>
